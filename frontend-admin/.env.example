# Copy to .env.production and fill in with the stack outputs (ApiUrl, UserPoolId, UserPoolClientId)
# before `npm.cmd run build`. None of these are secrets. Leave all unset for local development.
VITE_API_URL=https://xxxxxxxx.execute-api.eu-central-1.amazonaws.com
VITE_USER_POOL_ID=eu-central-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
