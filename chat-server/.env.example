# Copy to .env and fill in. .env is git-ignored. Never commit a real key.
ANTHROPIC_API_KEY=

# Anthropic's OpenAI-compatible endpoint
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-haiku-4-5-20251001

# The Medical Cabinet backend: the local dev server by default, or the deployed ApiUrl
API_BASE_URL=http://127.0.0.1:8000

# Set to false to keep clinical notes away from the LLM entirely
ENABLE_PATIENT_NOTES=true
